        private double calculate(double first, double second, String operator) {
            double result = 0;
            switch (operator) {
                case "+":
                    result = first + second;
                    break;
                case "-":
                    result = first - second;
                    break;
                case "x":
                    if (first != 0) {
                        result = first * second;

                    } else {
                        result = second;
                    }
                    break;
                case "÷":
                    if (first != 0) {
                        result = first / second;
                    } else {
                        result = second;
                    }
                    break;
                case "%":
                    if (first != 0) {
                        result = (first * second) / 100;
                    } else {
                        result = second;
                    }
                    break;
            }
//            return Double.parseDouble(formatWithCommas((formatNumber(result))));
            return result;
        }


    private void backSpaceLogic(){
        try {
            if (isEqualJustPressed){
                resultText.setText("");
                return;
            }
            if (input.isEmpty() || input.endsWith(operator)){
                return;
            }
            input = input.substring(0, input.length() -1);
            inputText.setText(input.isEmpty() ? "0" : input);
        } catch (Exception e){
            e.printStackTrace();
        }
    }



