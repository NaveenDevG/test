public void addValues(String number){


    if (number.equals(".")){
        input = input.isEmpty() ? "0." : input + ".";
    } else {
        input +=number;
    }
    if(resultText.getText().length()>0){
    if(Double.valueOf(input)!=(firstNumber) && !String.valueOf(resultText.getText().charAt(resultText.length()-1)).equals("x")
            && !String.valueOf(resultText.getText().charAt(resultText.length()-1)).equals("-") &&
            !String.valueOf(resultText.getText().charAt(resultText.length()-1)).equals("+")  && !String.valueOf(resultText.getText().charAt(resultText.length()-1)).equals("÷")){
        opertorFlag=true;
        resultText.setVisibility(INVISIBLE);
    }
    }
    inputText.setText((formatWithCommas(input)));

}

    public void setOperator(String op) {
        if (!input.isEmpty()) {
            secondNumber = Double.parseDouble(input); // Use Double here for accuracy
            if ((!operator.isEmpty() && isOperatorPressed ) || op.equals("+")   || op.equals("-") ){

                if(op.equals("-")){
                    firstNumber = calculate(secondNumber,firstNumber , op);
                }
                else{
                    firstNumber = calculate(firstNumber, secondNumber, op);
                }

            } else {
                firstNumber = secondNumber;
            }
            input = "";
        }

        resultText.setText(formatNumber(firstNumber) + " " + op);

        if(operator.isEmpty() || operator.equals(op) ){
            opertorFlag=true;
        }else{
            opertorFlag=false;
        }
        operator = op;

        isOperatorPressed = true;
        isEqualJustPressed = false;
        inputText.setText(formatWithCommas(formatNumber(firstNumber))); // Show current result
    }


