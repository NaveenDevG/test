    private String formatWithCommas(String input){
        if (input.isEmpty()){
            return "0";
        }
        try {
            input = input.replace(",","");
            long value = Long.parseLong(input);
            return String.format("%,d", value);
        } catch (NumberFormatException e){
            return input;
        }
    }

    private void calculatePercentage1(){
        try {
            if (!operator.isEmpty()){
                double secondOperand = Double.parseDouble(inputText.getText().toString().replace(",",""));
                double result = 0;
                double so = secondOperand/100;
                switch (operator){
                    case "+":
                        result = secondOperand + (secondOperand * (secondOperand/100));
                        break;
                    case "-":
                        result = secondOperand - (secondOperand * (secondOperand/100));
                        break;
                    case "x":
                        result = secondOperand * (secondOperand * (secondOperand/100));
                        break;
                    case "÷":
                        if (secondOperand != 0) {
                            result = secondOperand / (secondOperand * (secondOperand / 100));
                        }
                        break;
                }
                resultText.setText(formatNumber(secondOperand) + operator + formatNumber(so) + " =");
                inputText.setText(String.valueOf(formatNumber(so)));
                input = String.valueOf(result);
            }

        } catch (Exception e){
            e.printStackTrace();
        }
    }
    private void calculatePercentage(){
        try {
            if (!operator.isEmpty() ) {
                double secondOperand = Double.parseDouble(inputText.getText().toString().replace(",", ""));
                double percentageValue = (secondOperand) / 100;
                double result = 0;

                switch (operator) {
                    case "+":
                        result = (percentageValue*secondOperand);
                        break;
                    case "-":
                        result = (percentageValue*secondOperand);
                        break;
                    case "x":
                        result = firstNumber * percentageValue;
                        break;
                    case "÷":
                        if (percentageValue != 0) {
                            result = firstNumber / percentageValue;
                        } else {
                            resultText.setText("Error");
                            return;
                        }
                        break;
                }


                if (operator.equals("+")||operator.equals("-")){
                    resultText.setText(formatNumber(firstNumber) + " " + operator + " " + formatNumber(result) + " =");
                    inputText.setText(formatNumber(result));
                }else {
                    resultText.setText(formatNumber(firstNumber) + " " + operator + " " + formatNumber(percentageValue) + " =");
                    inputText.setText(formatNumber(percentageValue));
                }

                // Set result as new first number
//                firstNumber = result;
                input = String.valueOf(result);
                isOperatorPressed = false;
                isEqualJustPressed = true;
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
